# Browser-safe values from your Supabase project. Never use a secret/service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# M2 slice (apps/pwa). The model file is never committed: Nana Yaw hosts the fp32 ONNX file
# and sets its URL and SHA-256 here (and in Vercel). The app refuses a file whose hash differs.
VITE_MODEL_URL=https://example.org/path/to/efficientnet_lite0_seed1_20261021T114608Z.fp32.onnx
VITE_MODEL_SHA256=the-64-character-sha256-of-that-file
# Optional: shown in records so the monitoring page can tell builds apart (Vercel can set it).
VITE_APP_BUILD=local
