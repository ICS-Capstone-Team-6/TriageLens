# Copy to .env.local (git-ignored) and fill in locally. Never commit real values.
# Production and preview values live in Vercel and GitHub environment secrets (E13-01).
# Variable names are placeholders until the PWA (E8-02) and Supabase (E9-01) exist; confirm them then.

# Supabase project URL and public anon key (row-level security protects the data; TRD 10.7)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put the Supabase service-role key in the app or in any .env committed to git.
