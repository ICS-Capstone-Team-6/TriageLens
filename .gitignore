# TriageLens .gitignore
# Datasets and real patient data must never be committed (Team Rules 6 and 8).

# Node
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage
htmlcov/

# Environment and secrets (keep the example file)
.env
.env.*
!.env.example

# Personal Claude Code instructions
CLAUDE.local.md

# Datasets, runs and checkpoints
ml/data/
ml/runs/
ml/checkpoints/
mlruns/
wandb/

# Model binaries, except small fixtures used by tests
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
!**/test-fixtures/**/*.onnx
!**/test-fixtures/**/*.pt

# Build output
dist/
build/
.vite/
coverage/
playwright-report/
test-results/
.lighthouseci/
.vercel/

# Supabase local state
supabase/.branches/
supabase/.temp/

# Board automation logs
scripts/github/*.log

# OS and editor files
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
