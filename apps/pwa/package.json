{
  "name": "@triagelens/pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TriageLens M2 slice: TB screening on a chest X-ray, model on the phone (ADR-19).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
